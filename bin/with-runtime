#!/bin/sh
# Run a command on the Node runtime the Cockpit's services are pinned to.
#
# The services (api, agent broker, executor broker), the retention unit and the
# sudoers rules for the executor all name /opt/node-v22.23.4-linux-x64/bin/node.
# The host has other Node installs on other paths (/usr/bin/node from the nodejs
# distribution package, /usr/local/bin/node) at other ABIs. Native modules are
# built per ABI: better-sqlite3 in node_modules is compiled for the pinned major
# and refuses to load under another one ("Module did not self-register").
# Rebuilding node_modules for a different major would make the tests pass and the
# services fail — the opposite of what a test is for. So the tests run on the
# runtime the services run on, and a Node upgrade means: bump .node-version,
# install that runtime under /opt, then reinstall (npm ci) so the native module
# is built for the new ABI.
#
# The version lives in .node-version, the same file nvm/fnm read.
set -eu
HERE=$(cd "$(dirname "$0")/.." && pwd)
WANT=$(tr -d ' \n\r\t' < "$HERE/.node-version")
DIR="/opt/node-v${WANT}-linux-x64/bin"
if [ ! -x "$DIR/node" ]; then
  echo "with-runtime: the pinned Node $WANT is not installed at $DIR; the services in deploy/systemd run on it" >&2
  exit 69
fi
PATH="$DIR:$PATH"
export PATH
exec "$@"
