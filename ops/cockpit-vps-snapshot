#!/usr/bin/python3
"""Machine snapshots of this VPS through the hoster's API (Contabo).

Why this exists: the executor's own providers (`file`, `tree`) restore paths
inside the running system, which is exactly what a system update escapes —
`postinst` scripts, service migrations, schema changes happen below the level
any file copy can reach. The hoster snapshots the block device underneath
ext4, so a way back exists even for those. That is what makes them honestly
autonomisable: not that the tool restores by itself, but that a guaranteed
return path EXISTS before anything is touched.

The provider is deliberately asymmetric (doc/autonomy-through-guaranteed-
rollback.md, 18.08.2026):

    status, list, create   autonomous — creating a return path costs nothing
    delete, revert         operator approval — a revert is a time machine for
                           the whole host and takes everything since the
                           snapshot with it: mails the archive fetched, GitLab
                           commits, Nextcloud uploads. That is a judgement
                           call with collateral, not a calculation.

Credentials live in /etc/wireguard-ops-cockpit/contabo.env, root-only. They
never appear in a manifest, a job result, or a model's context: the executor
binds the file read-only into the sandbox and this helper reads it itself.
An API token here is a master key — whoever holds it can roll the machine
back — so it sits behind the same hard boundary as the agent's own secrets.

Deliberately absent: no instance create/delete/reinstall, no other instance
than the one this helper runs on, no arbitrary endpoint. Snapshots this tool
creates carry the prefix `cockpit-`; only those are ever rotated away when
the plan's limit is reached. A snapshot a person made by hand is never
deleted to make room.

Output: one JSON object on stdout. Errors: message on stderr, exit code
64 usage / 69 unavailable (no credentials, no instance) / 70 API failure.
"""
from __future__ import annotations

import json
import os
import re
import socket
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

ENV_FILE = "/etc/wireguard-ops-cockpit/contabo.env"
AUTH_URL = "https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token"
API = "https://api.contabo.com/v1"
PREFIX = "cockpit-"
NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,60}$")
PENDING = {"creating", "provisioning", "pending", "in_progress", "processing"}
USER_AGENT = "wireguard-ops-cockpit vps-snapshot"


def die(message: str, code: int = 70) -> "NoReturn":  # noqa: F821
    sys.stderr.write(message.rstrip() + "\n")
    sys.exit(code)


def usage() -> "NoReturn":  # noqa: F821
    die("usage: cockpit-vps-snapshot status|list|create <name> [--wait <seconds>]|delete <snapshotId>|revert <snapshotId>", 64)


# ─── Credentials ───────────────────────────────────────────────────────────
def load_env(path: str = ENV_FILE) -> dict:
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except FileNotFoundError:
        die(f"no hoster credentials at {path}; the operator deposits them with ops/contabo-zugang-hinterlegen.sh", 69)
    except PermissionError:
        die(f"hoster credentials at {path} are not readable here", 69)
    values = {}
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip().strip("'\"")
    missing = [k for k in ("CONTABO_CLIENT_ID", "CONTABO_CLIENT_SECRET", "CONTABO_API_USER", "CONTABO_API_PASSWORD") if not values.get(k)]
    if missing:
        die(f"hoster credentials are incomplete: {', '.join(missing)} missing", 69)
    return values


# ─── HTTP ──────────────────────────────────────────────────────────────────
class Api:
    def __init__(self, env: dict):
        self.env = env
        self.token = self._login()

    def _login(self) -> str:
        body = urllib.parse.urlencode({
            "client_id": self.env["CONTABO_CLIENT_ID"],
            "client_secret": self.env["CONTABO_CLIENT_SECRET"],
            "username": self.env["CONTABO_API_USER"],
            "password": self.env["CONTABO_API_PASSWORD"],
            "grant_type": "password",
        }).encode()
        request = urllib.request.Request(AUTH_URL, data=body, method="POST")
        request.add_header("Content-Type", "application/x-www-form-urlencoded")
        request.add_header("User-Agent", USER_AGENT)
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                data = json.loads(response.read())
        except urllib.error.HTTPError as error:
            # The body of a failed login can echo the request; only the status
            # is reported, never the body.
            die(f"hoster login failed (HTTP {error.code}); check the deposited credentials", 69)
        except (urllib.error.URLError, socket.timeout, OSError) as error:
            die(f"hoster login unreachable: {getattr(error, 'reason', error)}", 70)
        token = data.get("access_token")
        if not token:
            die("hoster login returned no access token", 69)
        return token

    def call(self, method: str, path: str, body: dict | None = None, ok: tuple = (200, 201)) -> tuple[int, dict]:
        request = urllib.request.Request(API + path, data=json.dumps(body).encode() if body is not None else None, method=method)
        request.add_header("Authorization", f"Bearer {self.token}")
        request.add_header("x-request-id", str(uuid.uuid4()))
        request.add_header("User-Agent", USER_AGENT)
        if body is not None:
            request.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                raw = response.read()
                return response.status, (json.loads(raw) if raw else {})
        except urllib.error.HTTPError as error:
            raw = error.read()
            try:
                data = json.loads(raw) if raw else {}
            except ValueError:
                data = {"message": raw.decode("utf-8", "replace")[:300]}
            if error.code in ok:
                return error.code, data
            return error.code, data
        except (urllib.error.URLError, socket.timeout, OSError) as error:
            die(f"hoster API unreachable: {getattr(error, 'reason', error)}", 70)


def message_of(data: dict) -> str:
    return str(data.get("message") or data.get("error") or data)[:300]


# ─── Instance ──────────────────────────────────────────────────────────────
def instance_of(api: Api) -> dict:
    """The one instance this helper runs on. Pinned by CONTABO_INSTANCE_ID, or
    found by the hoster's instance name, which Contabo uses as the hostname
    (vmd12345). A helper that could pick any instance would be a different,
    more dangerous tool."""
    pinned = api.env.get("CONTABO_INSTANCE_ID", "").strip()
    if pinned:
        if not pinned.isdigit():
            die("CONTABO_INSTANCE_ID must be numeric", 69)
        status, data = api.call("GET", f"/compute/instances/{pinned}")
        if status != 200:
            die(f"instance {pinned} not available: {message_of(data)}", 69)
        items = data.get("data") or []
        if not items:
            die(f"instance {pinned} not found", 69)
        return items[0]
    short = socket.gethostname().split(".")[0]
    status, data = api.call("GET", f"/compute/instances?name={urllib.parse.quote(short)}&size=10")
    if status != 200:
        die(f"instance lookup failed: {message_of(data)}", 70)
    matches = [item for item in data.get("data") or [] if item.get("name") == short]
    if len(matches) != 1:
        die(f"could not identify this host among the hoster's instances (name {short}, {len(matches)} matches); pin CONTABO_INSTANCE_ID", 69)
    return matches[0]


def instance_summary(item: dict) -> dict:
    ipv4 = ((item.get("ipConfig") or {}).get("v4") or {}).get("ip")
    return {k: item.get(k) for k in ("instanceId", "name", "displayName", "status", "productId", "region", "diskMb")} | {"ipv4": ipv4}


def snapshots_of(api: Api, instance_id: int) -> list[dict]:
    status, data = api.call("GET", f"/compute/instances/{instance_id}/snapshots?size=100&orderBy=createdDate:asc")
    if status != 200:
        die(f"listing snapshots failed: {message_of(data)}", 70)
    return [{k: item.get(k) for k in ("snapshotId", "name", "description", "createdDate", "autoDeleteDate", "status")}
            for item in data.get("data") or []]


def snapshot_by_id(api: Api, instance_id: int, snapshot_id: str) -> dict | None:
    status, data = api.call("GET", f"/compute/instances/{instance_id}/snapshots/{snapshot_id}")
    if status != 200:
        return None
    items = data.get("data") or []
    return items[0] if items else None


# ─── Freeze detection ──────────────────────────────────────────────────────
class Ticker(threading.Thread):
    """Measures whether THIS machine kept running while the hoster took the
    snapshot. If the hypervisor pauses the guest, the gap between two ticks
    grows far beyond the tick interval. The number answers the open question
    from the design: is the instance usable during creation?"""

    def __init__(self, interval: float = 0.25):
        super().__init__(daemon=True)
        self.interval = interval
        self.max_gap = 0.0
        self.ticks = 0
        self._stop = threading.Event()

    def run(self) -> None:
        last = time.monotonic()
        while not self._stop.is_set():
            time.sleep(self.interval)
            now = time.monotonic()
            self.max_gap = max(self.max_gap, now - last)
            self.ticks += 1
            last = now

    def stop(self) -> float:
        self._stop.set()
        self.join(timeout=2)
        return round(self.max_gap, 3)


# ─── Actions ───────────────────────────────────────────────────────────────
def act_status(api: Api) -> dict:
    inst = instance_of(api)
    snaps = snapshots_of(api, inst["instanceId"])
    return {"instance": instance_summary(inst), "snapshotCount": len(snaps), "snapshots": snaps}


def act_list(api: Api) -> dict:
    inst = instance_of(api)
    return {"instanceId": inst["instanceId"], "snapshots": snapshots_of(api, inst["instanceId"])}


def looks_like_limit(status: int, data: dict) -> bool:
    text = message_of(data).lower()
    return status in (400, 402, 403, 409, 422) and any(word in text for word in ("limit", "maximum", "exceed", "too many", "quota", "no more"))


def act_create(api: Api, name: str, wait: int) -> dict:
    if not NAME_RE.match(name):
        die("snapshot name: letters, digits, dot, underscore, dash; at most 60 characters", 64)
    if not name.startswith(PREFIX):
        name = PREFIX + name
    inst = instance_of(api)
    instance_id = inst["instanceId"]
    before = snapshots_of(api, instance_id)
    rotated = None
    ticker = Ticker()
    started = time.monotonic()
    ticker.start()
    body = {"name": name, "description": f"wireguard-ops-cockpit {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}"}
    status, data = api.call("POST", f"/compute/instances/{instance_id}/snapshots", body)
    if looks_like_limit(status, data):
        # Only snapshots this tool made are candidates. Oldest first: the one
        # least likely to still be someone's intended return path.
        own = [s for s in before if str(s.get("name", "")).startswith(PREFIX)]
        if not own:
            ticker.stop()
            die(f"the hoster's snapshot limit is reached and no cockpit-owned snapshot can be rotated; a person must delete one: {message_of(data)}", 70)
        oldest = own[0]
        del_status, del_data = api.call("DELETE", f"/compute/instances/{instance_id}/snapshots/{oldest['snapshotId']}", ok=(200, 204))
        if del_status not in (200, 204):
            ticker.stop()
            die(f"rotating {oldest['snapshotId']} failed: {message_of(del_data)}", 70)
        rotated = {k: oldest.get(k) for k in ("snapshotId", "name", "createdDate")}
        status, data = api.call("POST", f"/compute/instances/{instance_id}/snapshots", body)
    if status not in (200, 201):
        ticker.stop()
        die(f"creating snapshot failed (HTTP {status}): {message_of(data)}", 70)
    created = (data.get("data") or [{}])[0]
    snapshot_id = created.get("snapshotId")
    if not snapshot_id:
        ticker.stop()
        die("the hoster returned no snapshot id", 70)
    # Wait until the hoster no longer reports the snapshot as in progress and
    # the instance is back to running. What "in progress" is called is not
    # documented; the pending set is a guess, so the final state is reported
    # verbatim and the wait is capped.
    final = created
    deadline = time.monotonic() + max(wait, 5)
    while time.monotonic() < deadline:
        current = snapshot_by_id(api, instance_id, snapshot_id)
        if current is not None:
            final = current
            inst_status, inst_data = api.call("GET", f"/compute/instances/{instance_id}")
            running = ((inst_data.get("data") or [{}])[0].get("status") == "running") if inst_status == 200 else True
            if str(final.get("status", "")).lower() not in PENDING and running:
                break
        time.sleep(2)
    seconds = round(time.monotonic() - started, 1)
    max_gap = ticker.stop()
    return {
        "instanceId": instance_id,
        "snapshot": {k: final.get(k) for k in ("snapshotId", "name", "createdDate", "autoDeleteDate", "status")},
        "seconds": seconds,
        "maxGapSeconds": max_gap,
        "instanceStayedResponsive": max_gap < 3.0,
        "rotated": rotated,
        "snapshotCount": len(before) + (0 if rotated else 1),
    }


def act_delete(api: Api, snapshot_id: str) -> dict:
    if not snapshot_id.isalnum():
        die("snapshot id must be alphanumeric", 64)
    inst = instance_of(api)
    status, data = api.call("DELETE", f"/compute/instances/{inst['instanceId']}/snapshots/{snapshot_id}", ok=(200, 204))
    if status not in (200, 204):
        die(f"deleting {snapshot_id} failed (HTTP {status}): {message_of(data)}", 70)
    return {"instanceId": inst["instanceId"], "deleted": snapshot_id}


def act_revert(api: Api, snapshot_id: str) -> dict:
    if not snapshot_id.isalnum():
        die("snapshot id must be alphanumeric", 64)
    inst = instance_of(api)
    target = snapshot_by_id(api, inst["instanceId"], snapshot_id)
    if target is None:
        die(f"snapshot {snapshot_id} does not exist on this instance", 69)
    sys.stderr.write(f"reverting instance {inst['instanceId']} to {snapshot_id} ({target.get('name')}, {target.get('createdDate')}); "
                     "the machine will restart and everything written since is lost\n")
    sys.stderr.flush()
    status, data = api.call("POST", f"/compute/instances/{inst['instanceId']}/snapshots/{snapshot_id}/revert", {}, ok=(200, 201, 202, 204))
    if status not in (200, 201, 202, 204):
        die(f"revert failed (HTTP {status}): {message_of(data)}", 70)
    return {"instanceId": inst["instanceId"], "reverting": snapshot_id, "snapshotName": target.get("name"), "createdDate": target.get("createdDate")}


def main(argv: list[str]) -> None:
    if not argv:
        usage()
    action, rest = argv[0], argv[1:]
    wait = 600
    if "--wait" in rest:
        index = rest.index("--wait")
        try:
            wait = int(rest[index + 1])
        except (IndexError, ValueError):
            usage()
        if not 5 <= wait <= 3600:
            die("--wait: 5 to 3600 seconds", 64)
        rest = rest[:index] + rest[index + 2:]
    api = Api(load_env())
    if action == "status" and not rest:
        result = act_status(api)
    elif action == "list" and not rest:
        result = act_list(api)
    elif action == "create" and len(rest) == 1:
        result = act_create(api, rest[0], wait)
    elif action == "delete" and len(rest) == 1:
        result = act_delete(api, rest[0])
    elif action == "revert" and len(rest) == 1:
        result = act_revert(api, rest[0])
    else:
        usage()
    sys.stdout.write(json.dumps(result, ensure_ascii=False) + "\n")


if __name__ == "__main__":
    main(sys.argv[1:])
