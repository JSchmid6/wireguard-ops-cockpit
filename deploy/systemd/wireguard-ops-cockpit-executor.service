[Unit]
Description=WireGuard Ops Cockpit typed executor broker
After=network-online.target

[Service]
Type=simple
User=cockpit-executor
Group=cockpit-executor-client
WorkingDirectory=/opt/wireguard-ops-cockpit
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v20.19.1-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=COCKPIT_EXECUTOR_BROKER_SOCKET=/run/cockpit-executor/executor.sock
EnvironmentFile=/etc/wireguard-ops-cockpit/executor.env
RuntimeDirectory=cockpit-executor
RuntimeDirectoryMode=0770
ExecStart=/opt/node-v20.19.1-linux-x64/bin/node /opt/wireguard-ops-cockpit/apps/executor-broker/src/index.mjs
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=false
PrivateTmp=true
# The signed inner capability sandbox remounts / read-only and bind-mounts only
# envelope-authorized exact paths. `strict` here would make those host paths
# irreversibly read-only before the inner sandbox can narrow them.
ProtectSystem=true
# The outer executor must resolve envelope-authorized paths below /home before
# the inner transient unit hides everything and binds only those exact paths.
ProtectHome=read-only
ReadWritePaths=/run/cockpit-executor /var/lib/wireguard-ops-cockpit/capability-snapshots
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
