[Unit]
Description=WireGuard Ops Cockpit isolated agent broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cockpit-agent
Group=cockpit-agent-client
WorkingDirectory=/opt/wireguard-ops-cockpit
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v20.19.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=COCKPIT_AGENT_BROKER_SOCKET=/run/cockpit-agent/agent.sock
Environment=COCKPIT_AGENT_WORKSPACE_ROOT=/var/lib/wireguard-ops-agent/sessions
Environment=COCKPIT_OPENCODE_CONFIG=/var/lib/wireguard-ops-agent/.config/opencode/opencode.jsonc
# Engine: the Claude CLI on the subscription (doc/setup/agent-claude-cli.md).
# The broker never falls back to another engine; without a usable Claude every
# review answers "nicht verfuegbar" and nothing is approved. DeepSeek/opencode
# only with COCKPIT_AGENT_ENGINE=opencode in agent.env (labelled in every verdict).
Environment=COCKPIT_AGENT_ENGINE=claude
Environment=COCKPIT_AGENT_RUNS_ROOT=/var/lib/wireguard-ops-agent/runs
Environment=COCKPIT_CLAUDE_EXECUTABLE=/usr/local/bin/claude
Environment=COCKPIT_CLAUDE_CONFIG_DIR=/var/lib/wireguard-ops-agent/claude-config
# Long-lived token of the broker's own identity (claude setup-token), never the
# login of root or James: owner cockpit-agent, mode 0400, outside the repository.
Environment=COCKPIT_CLAUDE_TOKEN_FILE=/etc/wireguard-ops-agent/claude-oauth-token
Environment=COCKPIT_CLAUDE_REVIEW_MODEL=opus
Environment=COCKPIT_CLAUDE_WORK_MODEL=sonnet
EnvironmentFile=/etc/wireguard-ops-cockpit/agent.env
RuntimeDirectory=cockpit-agent
RuntimeDirectoryMode=0770
ExecStart=/opt/node-v20.19.1-linux-x64/bin/node /opt/wireguard-ops-cockpit/apps/agent-broker/src/index.mjs
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wireguard-ops-agent /run/cockpit-agent
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
