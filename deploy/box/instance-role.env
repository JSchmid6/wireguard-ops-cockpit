# Instanzrolle für die allgemeine Tür (cockpit-host-run, doc/setup/host-run.md
# „Netz je Instanzrolle“): box = Proxmox-Host (Narrow Box) — lokaler Host-Snapshot
# (cockpit-host-snapshot, /etc samt /etc/pve) und ein Proxmox-Snapshot jeder VM und
# jedes Containers vor jedem verändernden Lauf. Kein borg-Client, kein Hoster.
# Installiert von homeserver-cockpit-deploy.sh (COCKPIT_ROLE=box) nach
# /etc/wireguard-ops-cockpit/instance-role.env (root, 0600); nie von Hand ändern.
COCKPIT_INSTANCE_ROLE=box
