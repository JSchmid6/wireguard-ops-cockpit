[Unit]
Description=WireGuard Ops Cockpit web container (VPS, nginx + UI on 10.0.0.1:8080)
Documentation=https://github.com/JSchmid6/wireguard-ops-cockpit/blob/main/doc/setup/self-update.md
Requires=docker.service
After=docker.service network-online.target

# The image is built by vps-cockpit-deploy.sh; this unit only recreates the
# container from the image that is already there. `--force-recreate` makes every
# start swap the container instead of trusting compose's change detection, so a
# restart of this unit is the web part of the self-update activation (the runner
# restarts it with the four services, after its pre-activation checks, and then
# checks that the container carries the image the deploy built).
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/wireguard-ops-cockpit
ExecStart=/usr/bin/docker compose --env-file .env -f docker-compose.vps.yml up -d --no-build --force-recreate web
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
