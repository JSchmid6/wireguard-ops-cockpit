# Instanzrolle für die allgemeine Tür (cockpit-host-run, doc/setup/host-run.md
# „Netz je Instanzrolle“): vps = borg-Frische + Maschinen-Snapshot beim Hoster
# vor jedem verändernden Lauf. Installiert von vps-cockpit-deploy.sh nach
# /etc/wireguard-ops-cockpit/instance-role.env (root, 0600); nie von Hand ändern.
COCKPIT_INSTANCE_ROLE=vps
