# Instanzrolle für die allgemeine Tür (cockpit-host-run, doc/setup/host-run.md
# „Netz je Instanzrolle“): lab0 = lokaler Host-Snapshot (cockpit-host-snapshot)
# vor jedem verändernden Lauf — Lab0 ist borg-Ziel, kein borg-Client, und hat
# keinen Hoster. Installiert von homeserver-cockpit-deploy.sh nach
# /etc/wireguard-ops-cockpit/instance-role.env (root, 0600); nie von Hand ändern.
COCKPIT_INSTANCE_ROLE=lab0
