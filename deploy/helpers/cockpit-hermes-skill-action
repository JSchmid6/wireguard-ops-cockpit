#!/bin/sh
set -eu

action=${1:-}
skill_name=${2:-}
source_root=/home/hermes/.hermes/interface-app-4-ai-agents/tools/hermes-skills
target_root=/home/hermes/.hermes/skills

[ "$action" = install ] || {
  echo "usage: cockpit-hermes-skill-action install <skill-name>" >&2
  exit 64
}
case "$skill_name" in
  ''|*[!a-z0-9-]*) echo "invalid skill name" >&2; exit 64 ;;
esac

source_dir=$source_root/$skill_name
target_dir=$target_root/$skill_name
[ -f "$source_dir/SKILL.md" ] || { echo "source SKILL.md is missing" >&2; exit 66; }
[ -f "$source_dir/agents/openai.yaml" ] || { echo "source agent metadata is missing" >&2; exit 66; }
[ -f "$source_dir/references/protocol.md" ] || { echo "source protocol reference is missing" >&2; exit 66; }
[ ! -e "$target_dir" ] || { echo "target skill already exists" >&2; exit 73; }

install -d -m 0750 "$target_dir/agents" "$target_dir/references"
install -m 0640 "$source_dir/SKILL.md" "$target_dir/SKILL.md"
install -m 0640 "$source_dir/agents/openai.yaml" "$target_dir/agents/openai.yaml"
install -m 0640 "$source_dir/references/protocol.md" "$target_dir/references/protocol.md"

test "$(find "$target_dir" -type f | wc -l)" -eq 3
cmp -s "$source_dir/SKILL.md" "$target_dir/SKILL.md"
cmp -s "$source_dir/agents/openai.yaml" "$target_dir/agents/openai.yaml"
cmp -s "$source_dir/references/protocol.md" "$target_dir/references/protocol.md"
grep -q '^name: present-work-view$' "$target_dir/SKILL.md"
echo "installed_skill=$skill_name files=3 owner=hermes"
