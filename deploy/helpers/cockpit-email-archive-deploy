#!/bin/sh
set -eu

action=${1:-}
commit=${2:-}
source_dir=/home/hermes/.hermes/email-archive
image=172.30.0.4:5000/jochen/email-archive
DOCKER_CONFIG=/tmp/cockpit-email-archive-docker-config
export DOCKER_CONFIG

[ "$action" = build-push ] || {
  echo "usage: cockpit-email-archive-deploy build-push <commit>" >&2
  exit 64
}
[ "$commit" = 63f39b2 ] || { echo "unreviewed commit" >&2; exit 77; }
[ "$(git -c safe.directory="$source_dir" -C "$source_dir" rev-parse --short=7 HEAD)" = "$commit" ] || {
  echo "source commit mismatch" >&2
  exit 65
}
git -c safe.directory="$source_dir" -C "$source_dir" diff --quiet
git -c safe.directory="$source_dir" -C "$source_dir" diff --cached --quiet
mkdir -p "$DOCKER_CONFIG"

docker build -t "$image:$commit" -t "$image:latest" "$source_dir"
docker push "$image:$commit"
docker push "$image:latest"
echo "built_and_pushed=$image commit=$commit registry=private"
