def run_bytes(argv, phase, timeout=300):
    try:
        return subprocess.run(argv, capture_output=True, timeout=timeout)
    except FileNotFoundError as exc:
        raise Failure(67, phase, "required tool is missing: %s" % exc.filename)
    except subprocess.TimeoutExpired:
        raise Failure(67, phase, "command timed out: %s" % " ".join(argv[:6]))


def diff_args(*extra):
    return [GIT, "-C", REPO_DIR, "-c", "core.quotePath=true", "diff", *DIFF_OPTIONS, *extra]


def verified_base(state, phase):
    """The review base: the deployed commit (state.json), else the checkout HEAD."""
    base = current_deployed_commit(state)
    if base is None:
        raise Failure(67, phase, "the deployed base commit is unknown (no state.json and no readable checkout HEAD)")
    known = git("rev-parse", "--verify", "--quiet", "%s^{commit}" % base, timeout=30)
    if known.returncode != 0:
        raise Failure(67, phase, "the deployed base commit %s is not in the pinned checkout" % base)
    return base


def full_diff(base, sha, phase):
    result = run_bytes(diff_args(base, sha, "--"), phase)
    if result.returncode != 0:
        raise Failure(67, phase, "git diff failed: %s" % (result.stderr.decode("utf-8", "replace").strip()[-300:] or "no output"))
    return result.stdout


def diff_listing(base, sha, mode):
    result = run_bytes(diff_args(mode, "-z", base, sha, "--"), "diff")
    if result.returncode != 0:
        raise Failure(67, "diff", "git diff %s failed" % mode)
    return [item.decode("utf-8", "replace") for item in result.stdout.split(b"\0")]


def c_unquote(text):
    """Decodes one C-style quoted token as git prints it (core.quotePath)."""
    escapes = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13, '"': 34, "\\": 92}
    out = bytearray()
    index = 1
    while index < len(text) and text[index] != '"':
        char = text[index]
        if char == "\\" and index + 1 < len(text):
            following = text[index + 1]
            if following in "01234567":
                try:
                    out.append(int(text[index + 1:index + 4], 8) & 0xFF)
                except ValueError:
                    out.append(ord(following))
                index += 4
                continue
            out.append(escapes.get(following, ord(following) & 0xFF))
            index += 2
            continue
        out.extend(char.encode("utf-8"))
        index += 1
    return out.decode("utf-8", "replace")


def header_path(line):
    # With --no-renames both sides name the same path: "a/P b/P" or quoted.
    rest = line[len("diff --git "):]
    if rest.startswith('"'):
        return c_unquote(rest)[2:]
    half = (len(rest) - 5) // 2
    if half > 0 and rest.startswith("a/") and rest[2 + half:5 + half] == " b/" and rest[2:2 + half] == rest[5 + half:]:
        return rest[2:2 + half]
    return rest


def split_sections(text):
    # Only "\n" splits: a file line can never start a new section because every
    # content line carries its " ", "+" or "-" prefix.
    sections = []
    for line in text.split("\n"):
        if line.startswith("diff --git "):
            sections.append({"path": header_path(line), "lines": [line]})
        elif sections and line:
            sections[-1]["lines"].append(line)
    for section in sections:
        head, hunks = [], []
        old_no = new_no = 0
        for line in section["lines"]:
            match = HUNK_RE.match(line) if line.startswith("@@") else None
            if match:
                old_no, new_no = int(match.group(1)), int(match.group(3))
                hunks.append({"lines": [line], "removed": [], "added": []})
            elif not hunks:
                head.append(line)
            else:
                hunks[-1]["lines"].append(line)
                if line.startswith("+"):
                    hunks[-1]["added"].append((new_no, line[1:]))
                    new_no += 1
                elif line.startswith("-"):
                    hunks[-1]["removed"].append((old_no, line[1:]))
                    old_no += 1
                elif line.startswith(" "):
                    old_no += 1
                    new_no += 1
        section["head"] = head
        section["hunks"] = hunks
        section["text"] = "\n".join(section["lines"]) + "\n"
    return sections


def block_end(lines, start):
    """Last line (1-based) of the function whose definition is on lines[start].

    Heuristic brace matching: the body is the first "{" after the parameter
    list closes; strings and // comments are skipped. When the end cannot be
    found the span runs to the end of the file (a wider focus, never a narrower one)."""
    paren = brace = 0
    seen_paren = in_body = False
    quote = None
    for number in range(start, len(lines)):
        line = lines[number]
        index = 0
        while index < len(line):
            char = line[index]
            if quote:
                if char == "\\":
                    index += 2
                    continue
                if char == quote:
                    quote = None
            elif char in "'\"`":
                quote = char
            elif char == "/" and line[index + 1:index + 2] == "/":
                break
            elif char == "(":
                paren += 1
                seen_paren = True
            elif char == ")":
                paren -= 1
            elif char == "{":
                if seen_paren and paren <= 0 and brace == 0:
                    in_body = True
                brace += 1
            elif char == "}":
                brace -= 1
                if in_body and brace == 0:
                    return number + 1
            index += 1
        if quote in ("'", '"'):
            quote = None
    return len(lines)


def function_spans(content, names):
    lines = content.split("\n")
    spans = {}
    for name in names:
        definition = re.compile(r"(?:^|[^\w$.])(?:function\s*\*?\s*%s\s*\(|(?:const|let|var)\s+%s\s*=)"
                                % (re.escape(name), re.escape(name)))
        for index, line in enumerate(lines):
            if definition.search(line):
                spans.setdefault(name, []).append((index + 1, block_end(lines, index)))
    return spans


def file_at(commit, path):
    shown = run_bytes([GIT, "-C", REPO_DIR, "show", "%s:%s" % (commit, path)], "diff", timeout=60)
    return shown.stdout.decode("utf-8", "replace") if shown.returncode == 0 else ""


def signing_touches(path, names, base, sha, hunks):
    """Names of signing/verification functions a change touches, and the hunks."""
    old_spans = function_spans(file_at(base, path), names)
    new_spans = function_spans(file_at(sha, path), names)
    touched = {name for name in names if bool(old_spans.get(name)) != bool(new_spans.get(name))}
    touching = []
    for hunk in hunks:
        hit = set()
        for name in names:
            word = re.compile(r"(?<![\w$])%s(?![\w$])" % re.escape(name))
            if any(start <= number <= end for number, _ in hunk["removed"] for start, end in old_spans.get(name, ())) \
                    or any(start <= number <= end for number, _ in hunk["added"] for start, end in new_spans.get(name, ())) \
                    or any(word.search(text) for _, text in hunk["removed"] + hunk["added"]):
                hit.add(name)
        if hit:
            touched |= hit
            touching.append(hunk)
    return sorted(touched), touching


def sudoers_additions(hunk):
    # "#include"/"#includedir" are sudoers directives, not comments.
    added = []
    for _, text in hunk["added"]:
        stripped = text.strip()
        if stripped and (not stripped.startswith("#") or re.match(r"#include(?:dir)?\b", stripped)):
            added.append(stripped)
    return added


def quote_hunks(section, hunks):
    quoted = []
    for hunk in hunks[:FOCUS_HUNKS_PER_FILE]:
        text = "\n".join(section["head"] + hunk["lines"])
        if len(text) > FOCUS_HUNK_LIMIT:
            text = text[:FOCUS_HUNK_LIMIT].rsplit("\n", 1)[0] + "\n[... hunk truncated ...]"
        quoted.append(text)
    if not quoted:
        quoted.append("\n".join(section["head"])[:FOCUS_HUNK_LIMIT])
    return quoted


def hunk_area(kind, guarantees, reason, section, hunks):
    return {"kind": kind, "guarantees": list(guarantees), "reason": reason, "files": [section["path"]],
            "hunks": quote_hunks(section, hunks), "hunksOmitted": max(0, len(hunks) - FOCUS_HUNKS_PER_FILE)}


def hunk_focus_areas(sections, base, sha):
    """Hunk-precise focus areas: sudoers additions, the update mechanism, and
    the envelope signing / broker validation functions."""
    areas = []
    for section in sections:
        path, hunks = section["path"], section["hunks"]
        binary = any(line.startswith("Binary files ") for line in section["head"])
        if path.startswith("deploy/sudoers/"):
            adding = [hunk for hunk in hunks if sudoers_additions(hunk)]
            if adding or binary:
                count = sum(len(sudoers_additions(hunk)) for hunk in adding)
                reason = ("%d non-comment sudoers line(s) added to %s" % (count, path)) if adding \
                    else "binary content in the sudoers source %s" % path
                areas.append(hunk_area("sudoers-additions", ("G4",), reason, section, adding))
        if path in UPDATE_MECHANISM_FILES:
            areas.append(hunk_area("update-mechanism", ("G7",), "the self-update/review mechanism itself changes (%s)" % path,
                                   section, hunks))
        if path in SIGNING_FUNCTIONS:
            kind, guarantees, names = SIGNING_FUNCTIONS[path]
            touched, touching = signing_touches(path, names, base, sha, hunks)
            if touched:
                areas.append(hunk_area(kind, guarantees, "%s changes %s" % (path, ", ".join(touched)), section,
                                       touching or hunks))
    return areas


def classify_path(path, status, precise, focus):
    name = path.rsplit("/", 1)[-1]
    if name == "package-lock.json":
        return "lockfile"
    if path in precise:
        return "focus-hunks"
    if name == "package.json":
        return "dependency"
    if TEST_PATH_RE.search(path) and status == "D":
        return "test-deleted"
    if path in focus:
        return "focus"
    if TEST_PATH_RE.search(path):
        return "test"
    return "other"


def lockfile_packages(sections):
    """Package changes named in package-lock.json hunks. Entries with an install
    script or a source outside the npm registry are always listed in full."""
    key_re = re.compile(r'^[ +-]\s*"((?:[^"]*/)?node_modules/(?:@[^/"]+/)?[^"/]+)": \{')
    field_re = re.compile(r'^([+-])\s*"(version|resolved|hasInstallScript)": "?([^",]+)"?,?$')
    changes = {}
    for section in sections:
        for hunk in section["hunks"]:
            current = None
            for line in hunk["lines"][1:]:
                key = key_re.match(line)
                if key:
                    current = key.group(1).rsplit("node_modules/", 1)[-1]
                    entry = changes.setdefault(current, {})
                    if line.startswith("+"):
                        entry["added"] = True
                    elif line.startswith("-"):
                        entry["removed"] = True
                    continue
                field = field_re.match(line)
                if field and current:
                    entry = changes.setdefault(current, {})
                    sign, name, value = field.groups()
                    if name == "version":
                        entry["new" if sign == "+" else "old"] = value
                    elif sign == "+" and name == "resolved":
                        entry["resolved"] = value
                    elif sign == "+" and name == "hasInstallScript" and value == "true":
                        entry["installScript"] = True
    risky, plain = [], []
    for name in sorted(changes):
        entry = changes[name]
        if entry.get("removed") and not entry.get("added"):
            line = "-%s@%s" % (name, entry.get("old", "?"))
        elif entry.get("added") and not entry.get("removed"):
            line = "+%s@%s" % (name, entry.get("new", "?"))
        elif entry.get("old") != entry.get("new") or entry.get("resolved") or entry.get("installScript"):
            line = "%s %s -> %s" % (name, entry.get("old", "?"), entry.get("new", "?"))
        else:
            continue
        resolved = entry.get("resolved", "")
        host = re.match(r"^[a-z+]+://([^/]+)", resolved)
        foreign = bool(resolved) and not (host and host.group(1) == REGISTRY_HOST) and "://" in resolved \
            or resolved.startswith(("git", "file:", "github:"))
        notes = (["install script"] if entry.get("installScript") else []) + (["source: %s" % resolved[:120]] if foreign else [])
        (risky if notes else plain).append(line + ("" if not notes else " (%s)" % "; ".join(notes)))
    if len(plain) > PACKAGES_LIMIT:
        plain = plain[:PACKAGES_LIMIT] + ["... and %d more npm-registry packages without install scripts" % (len(plain) - PACKAGES_LIMIT)]
    return risky + plain


def review_report(base, sha, raw):
    text = raw.decode("utf-8", "replace")
    sections = split_sections(text)
    listing = diff_listing(base, sha, "--name-status")
    numstat = diff_listing(base, sha, "--numstat")
    counts = {}
    for record in numstat:
        parts = record.split("\t", 2)
        if len(parts) == 3:
            counts[parts[2]] = (None if parts[0] == "-" else int(parts[0]), None if parts[1] == "-" else int(parts[1]))
    changed = [(listing[index][:1], listing[index + 1]) for index in range(0, len(listing) - 1, 2) if listing[index]]
    areas = hunk_focus_areas(sections, base, sha)
    precise = {path for area in areas for path in area["files"]}
    for kind, guarantees, reason, matches in FILE_AREAS:
        paths = [path for _, path in changed if matches(path)]
        if paths:
            areas.append({"kind": kind, "guarantees": list(guarantees), "reason": reason, "files": paths})
    manifests = [path for _, path in changed if path.rsplit("/", 1)[-1] == "package.json"]
    locks = [path for _, path in changed if path.rsplit("/", 1)[-1] == "package-lock.json"]
    if manifests or locks:
        # The lockfile itself is summarized, not a focus file: its hunks are
        # noise, the package list (install scripts, foreign sources first) is not.
        areas.append({"kind": "dependencies", "guarantees": ["G8"], "files": manifests, "lockfiles": locks,
                      "reason": "dependency manifests changed; packages run inside the Cockpit services and CI",
                      "packages": lockfile_packages([s for s in sections if s["path"] in locks])})
    deleted_tests = [path for status, path in changed if status == "D" and TEST_PATH_RE.search(path)]
    if deleted_tests:
        areas.append({"kind": "tests-deleted", "guarantees": [], "files": deleted_tests,
                      "reason": "test files were deleted; check which guarantee they covered"})
    focus = {path for area in areas for path in area["files"]}
    files = []
    for status, path in changed:
        added, deleted = counts.get(path, (None, None))
        files.append({"status": status, "path": path, "added": added, "deleted": deleted,
                      "class": classify_path(path, status, precise, focus)})
    classes = {entry["path"]: entry["class"] for entry in files}
    ordered = sorted(enumerate(sections), key=lambda item: (CLASS_ORDER.get(classes.get(item[1]["path"], "other"), 5), item[0]))
    parts, omitted, partial = [], [], []
    used = 0
    truncated = False
    for _, section in ordered:
        chunk = section["text"].encode("utf-8")
        if truncated:
            omitted.append(section["path"])
        elif used + len(chunk) <= EXCERPT_LIMIT:
            parts.append({"path": section["path"], "text": section["text"]})
            used += len(chunk)
        else:
            truncated = True
            room = EXCERPT_LIMIT - used
            if room > 2048:
                cut = chunk[:room].decode("utf-8", "ignore").rsplit("\n", 1)[0]
                parts.append({"path": section["path"], "text": cut + "\n[... %s truncated ...]\n" % section["path"]})
                partial.append(section["path"])
            else:
                omitted.append(section["path"])
    stat = run_bytes(diff_args("--stat=160,100", base, sha, "--"), "diff")
    return {
        "base": base,
        "sha": sha,
        "diffSha256": hashlib.sha256(raw).hexdigest(),
        "diffBytes": len(raw),
        "files": files[:FILES_LIMIT],
        "filesTotal": len(files),
        "stat": stat.stdout.decode("utf-8", "replace")[-STAT_LIMIT:],
        "focusAreas": areas,
        # One entry per file section of the unified diff, focus areas first;
        # the path comes from here, so no consumer re-parses diff headers.
        "excerpt": parts,
        "excerptBytes": used,
        "truncated": truncated,
        "partialFiles": partial,
        "omittedFiles": omitted[:FILES_LIMIT],
    }


def shared_run_lock():
    """run.lock held shared while reviewing: refused (66) during a deployment,
    and a deployment cannot start under a half-read base."""
    try:
        fd = os.open(RUN_LOCK, os.O_RDONLY)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise Failure(66, "diff", "a self-update deployment is running; review the diff after it finished")
    return fd


def cmd_diff(sha):
    shared_run_lock()
    subject = check_repo_and_commit(sha)
    state = read_json(STATE_FILE)
    state = state if isinstance(state, dict) else None
    base = verified_base(state, "diff")
    report = review_report(base, sha, full_diff(base, sha, "diff"))
    report.update({"ok": True, "action": "self.diff", "version": 1, "commitSubject": subject,
                   "baseSource": "state" if state and state.get("deployed_commit") == base else "git-head"})
    print(json.dumps(report, sort_keys=True), flush=True)


def check_reviewed_diff(sha, reviewed_sha256, state):
    base = verified_base(state, "review")
    actual = hashlib.sha256(full_diff(base, sha, "review")).hexdigest()
    if actual != reviewed_sha256:
        raise Failure(65, "review", "reviewed diff mismatch: %s..%s now hashes to %s but the review covered %s "
                      "(the deployed base moved or the code changed since the review; review again)"
                      % (base[:12], sha[:12], actual, reviewed_sha256))
    return {"base": base, "diff_sha256": actual, "match": True}


def http_code(url, max_time=10, insecure=False):
    args = [CURL, "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", str(max_time)]
    if insecure:
        args.append("-k")
    args.append(url)
    result = run(args, timeout=max_time + 15)
    return result.stdout.strip() if result.returncode == 0 else "000"


def http_body(url, max_time=10, insecure=False):
    args = [CURL, "-fsS", "--max-time", str(max_time)]
    if insecure:
        args.append("-k")
    args.append(url)
    result = run(args, timeout=max_time + 15)
    return result.stdout if result.returncode == 0 else ""


def wg_ip_present():
    result = run([IP, "-brief", "a"], timeout=15)
    if result.returncode != 0:
        return False
    return re.search(r"(?:^|\s)%s(?:/\d+)?(?:\s|$)" % re.escape(WG_IP), result.stdout) is not None


def socket_ok(path):
    try:
        return stat.S_ISSOCK(os.lstat(path).st_mode)
    except OSError:
        return False


def state_web_url():
    state = read_json(STATE_FILE)
    if isinstance(state, dict):
        return state.get("web_url") or ""
    return ""


def verify_phase(retries, delay, include_web):
    """Runs the verification checks; raises Failure(68, ...) with the first breach."""
    checks = {}
    revision = git("rev-parse", "HEAD", timeout=30)
    if revision.returncode != 0 or revision.stdout.strip() != ACTIVE_SHA:
        raise Failure(68, "verify", "checkout HEAD is not the pinned commit (%s)" % (revision.stdout.strip() or "unreadable"))
    checks["revision"] = "ok"
    last = ""
    for _ in range(retries):
        missing = [name for name in SERVICES if run([SYSTEMCTL, "is-active", "--quiet", name], timeout=15).returncode != 0]
        if not missing:
            break
        last = ",".join(missing)
        time.sleep(delay)
    if last:
        raise Failure(68, "verify", "services not active: %s" % last)
    checks["services"] = "ok"
    last = ""
    for _ in range(retries):
        missing = [path for path in SOCKETS if not socket_ok(path)]
        if not missing:
            break
        last = ",".join(missing)
        time.sleep(delay)
    if last:
        raise Failure(68, "verify", "broker sockets missing: %s" % last)
    checks["sockets"] = "ok"
    healthy = False
    for _ in range(retries):
        if '"ok":true' in http_body(API_HEALTH_URL):
            healthy = True
            break
        time.sleep(delay)
    if not healthy:
        raise Failure(68, "verify", "API health is not ok (%s)" % API_HEALTH_URL)
    checks["api_health"] = "ok"
    ttyd_code = "000"
    for _ in range(retries):
        ttyd_code = http_code(TTYD_URL)
        if ttyd_code == "200":
            break
        time.sleep(delay)
    if ttyd_code != "200":
        raise Failure(68, "verify", "ttyd did not answer HTTP 200 (got %s)" % ttyd_code)
    checks["ttyd"] = "ok"
    web_url = state_web_url()
    if include_web and web_url and wg_ip_present():
        web_code = "000"
        for _ in range(retries):
            web_code = http_code(web_url + "/", insecure=True)
            if web_code == "200":
                break
            time.sleep(delay)
        if web_code != "200":
            raise Failure(68, "verify", "web did not answer HTTP 200 on %s/ (got %s)" % (web_url, web_code))
        if '"ok":true' not in http_body(web_url + "/api/health", insecure=True):
            raise Failure(68, "verify", "API health through the web chain is not ok (%s/api/health)" % web_url)
        checks["web"] = "ok"
    else:
        checks["web"] = "skipped"
    return checks


def acquire_run_lock():
    fd = os.open(RUN_LOCK, os.O_RDWR | os.O_CREAT, 0o640)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def open_log(prefix, sha):
    path = os.path.join(LOG_DIR, "%s-%s-%s.log" % (time.strftime("%Y%m%d-%H%M%S"), prefix, sha[:7]))
    global LOG_HANDLE
    LOG_HANDLE = open(path, "a", encoding="utf-8")
    os.chmod(path, 0o640)
    return path


def base_result(sha, started, phase, ok, code=None, error=None):
    result = {
        "ok": ok,
        "action": "self.update",
        "sha": sha,
        "phase": phase,
        "result": "ok" if ok else "failed",
        "started_at": started,
        "finished_at": utcnow(),
        "unit": "wireguard-ops-cockpit-self-update@%s.service" % (ACTIVE_INSTANCE or sha),
    }
    if code is not None:
        result["code"] = code
    if error:
        result["error"] = error
    if LOG_HANDLE is not None:
        result["log"] = LOG_HANDLE.name
    return result


def finish(result, exit_code):
    write_json_atomic(RESULT_FILE, result)
    note_history({"ts": result.get("finished_at"), "sha": result.get("sha"), "phase": result.get("phase"),
                  "result": result.get("result"), "code": result.get("code"), "log": result.get("log")})
    if result.get("ok") is True:
        print(json.dumps(result, sort_keys=True), flush=True)
        sys.exit(exit_code)
    print(json.dumps(result, sort_keys=True), flush=True, file=sys.stderr)
    sys.exit(exit_code)


def fail_with(result, exc):
    result["ok"] = False
    result["result"] = "failed"
    result["phase"] = exc.phase
    result["code"] = exc.code
    result["error"] = exc.message
    result["finished_at"] = utcnow()
    finish(result, exc.code)


def cmd_deploy(sha, reviewed_sha256):
    started = utcnow()
    ensure_dir(STATE_DIR)
    ensure_dir(LOG_DIR)
    deploy_sha256 = check_deploy_script()
    if acquire_run_lock() is None:
        raise Failure(66, "check", "another self-update run (deployment or review diff) is in progress")
    logfile = open_log("deploy", sha)
    log("self-update deploy %s (log %s)" % (sha, logfile))
    commit_subject = check_repo_and_commit(sha)
    log("commit accepted: %s %s" % (sha[:12], commit_subject))
    state = read_json(STATE_FILE)
    # The old code reviewed exactly base..sha; anything else is refused here,
    # before the deploy script can run.
    review = check_reviewed_diff(sha, reviewed_sha256, state if isinstance(state, dict) else None)
    previous = review["base"]
    log("reviewed diff matches: %s..%s sha256 %s" % (previous[:12], sha[:12], reviewed_sha256))
    result = base_result(sha, started, "check", True)
    result["previous_commit"] = previous
    result["commit_subject"] = commit_subject
    result["review"] = review
    result["deploy"] = {"script": DEPLOY_SH, "sha256": deploy_sha256, "result": "failed", "exit_code": None, "log": logfile}
    log("previous deployed commit: %s" % (previous or "unknown"))
    log("running the reviewed deploy script (REPO_COMMIT=%s, service restarts deferred)" % sha)
    try:
        child_env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root", "REPO_COMMIT": sha,
                     "COCKPIT_RESTART_MODE": "defer", "COCKPIT_SELF_UPDATE_SOURCE": "self-update"}
        with open(logfile, "ab") as handle:
            proc = subprocess.run(["bash", DEPLOY_SH], stdout=handle, stderr=handle, env=child_env)
        result["deploy"]["exit_code"] = proc.returncode
        if proc.returncode != 0:
            raise Failure(69, "deploy", "deploy script exited %s — see %s" % (proc.returncode, logfile))
        result["deploy"]["result"] = "ok"
        log("deploy script finished ok; verifying the host before activation")
        checks = verify_phase(retries=VERIFY_RETRIES, delay=VERIFY_DELAY, include_web=True)
        result["verification"] = checks
        log("pre-activation verification ok: %s" % json.dumps(checks, sort_keys=True))
        # The deploy script records the deployed commit (and web_url) itself;
        # re-read so its fields are preserved. Fall back to the pre-deploy
        # snapshot when the deploy script did not write state.
        fresh = read_json(STATE_FILE)
        new_state = dict(fresh) if isinstance(fresh, dict) else (dict(state) if isinstance(state, dict) else {})
        if new_state.get("deployed_commit") != sha:
            new_state["previous_commit"] = previous
            new_state["state_seeded_by_runner"] = True
        if "previous_commit" not in new_state:
            new_state["previous_commit"] = previous
        new_state.update({
            "version": 1,
            "deployed_commit": sha,
            "updated_at": utcnow(),
            "updated_by": "self-update",
        })
        unit_name = "wireguard-ops-cockpit-self-update-activate-%s-%d" % (sha[:7], int(time.time()))
        schedule = run([SYSTEMD_RUN, "--collect", "--quiet", "--unit=%s" % unit_name,
                        "--description=Cockpit self-update activation %s" % sha[:12],
                        "--working-directory=/", "--on-active=%d" % ACTIVATION_DELAY,
                        RUN_PATH, "activate", sha], timeout=30)
        if schedule.returncode != 0:
            raise Failure(69, "schedule", "activation could not be scheduled: %s" % (schedule.stderr.strip()[-300:] or "no output"))
        activation = {"status": "scheduled", "unit": unit_name, "scheduled_at": utcnow(), "delay_seconds": ACTIVATION_DELAY}
        result["activation"] = activation
        result["phase"] = "awaiting-activation"
        new_state["activation"] = {"status": "scheduled", "unit": unit_name, "checked_at": None}
        log("activation scheduled as %s in %ss" % (unit_name, ACTIVATION_DELAY))
        write_json_atomic(STATE_FILE, new_state)
        finish(result, 0)
    except Failure as exc:
        if exc.phase in ("verify", "schedule"):
            current = read_json(STATE_FILE)
            if isinstance(current, dict):
                current["activation"] = {"status": "not-activated", "checked_at": utcnow(), "detail": exc.message[:300]}
                current["updated_at"] = utcnow()
                write_json_atomic(STATE_FILE, current)
        fail_with(result, exc)


def cmd_activate(sha):
    started = utcnow()
    ensure_dir(STATE_DIR)
    ensure_dir(LOG_DIR)
    if acquire_run_lock() is None:
        logfile = open_log("activate", sha)
        log("a self-update deployment is running; activation for %s skipped (the running deployment schedules its own activation)" % sha[:12])
        note_history({"ts": utcnow(), "sha": sha, "phase": "activate", "result": "skipped-busy", "log": logfile})
        return
    logfile = open_log("activate", sha)
    log("self-update activation %s (log %s)" % (sha, logfile))
    state = read_json(STATE_FILE)
    deployed = state.get("deployed_commit") if isinstance(state, dict) else None
    if deployed != sha:
        log("superseded: deployed commit is %s, this activation was for %s — skipped" % (deployed or "unknown", sha))
        note_history({"ts": utcnow(), "sha": sha, "phase": "activate", "result": "skipped-superseded",
                      "deployed_commit": deployed, "log": logfile})
        return
    result = read_json(RESULT_FILE)
    if not isinstance(result, dict) or result.get("sha") != sha:
        result = base_result(sha, started, "awaiting-activation", True)
        result["previous_commit"] = state.get("previous_commit")
    log("restarting the four cockpit services to activate commit %s" % sha[:12])
    restart = run([SYSTEMCTL, "restart"] + SERVICES, timeout=300)
    restart_detail = restart.stderr.strip()[-300:]
    checks = None
    error = None
    try:
        checks = verify_phase(retries=VERIFY_RETRIES * 2, delay=VERIFY_DELAY, include_web=True)
    except Failure as exc:
        error = exc.message
    service_timestamps = {}
    for name in SERVICES:
        stamp = run([SYSTEMCTL, "show", "-p", "ActiveEnterTimestamp", "--value", name], timeout=15)
        service_timestamps[name] = stamp.stdout.strip()
    activation = {"status": "ok" if checks and not error else "failed",
                  "unit": "wireguard-ops-cockpit-self-update-activate-%s" % sha[:7],
                  "started_at": started, "finished_at": utcnow(),
                  "checks": checks, "services": service_timestamps}
    if restart.returncode != 0:
        activation["status"] = "failed"
        activation["restart_exit_code"] = restart.returncode
        activation["restart_error"] = restart_detail
        error = error or ("service restart failed (%s)" % (restart_detail or restart.returncode))
    result["activation"] = activation
    result["finished_at"] = utcnow()
    new_state = dict(state)
    new_state["activation"] = {"status": activation["status"], "unit": activation["unit"], "checked_at": utcnow()}
    new_state["updated_at"] = utcnow()
    if activation["status"] == "ok":
        result["phase"] = "activated"
        log("activation verified: %s" % json.dumps(checks, sort_keys=True))
        write_json_atomic(STATE_FILE, new_state)
        finish(result, 0)
    result["ok"] = False
    result["result"] = "failed"
    result["phase"] = "activate"
    result["code"] = 68
    result["error"] = error or "activation verification failed"
    write_json_atomic(STATE_FILE, new_state)
    finish(result, 68)


def refuse(code, message):
    print(json.dumps({"ok": False, "error": message, "code": code}), file=sys.stderr)
    sys.exit(code)


def main():
    if len(sys.argv) != 3:
        refuse(64, "usage: cockpit-self-update-run deploy <sha>-<diff-sha256> | activate <sha> | diff <sha>")
    command, target = sys.argv[1], sys.argv[2]
    if command not in ("deploy", "activate", "diff"):
        refuse(64, "unsupported command: %s" % command)
    reviewed_sha256 = None
    if command == "deploy":
        # Every deployment carries the hash of the diff the running Cockpit
        # reviewed; a bare sha is an unreviewed update and is refused.
        reviewed = REVIEWED_TARGET_RE.match(target)
        if not reviewed:
            refuse(65, "unreviewed deploy refused: the instance must be <sha>-<reviewed diff sha256> "
                       "(run cockpit-self-update-action diff <sha> and review it first)" if SHA_RE.match(target)
                   else "deploy target must be <40-hex sha>-<64-hex reviewed diff sha256>")
        sha, reviewed_sha256 = reviewed.group(1), reviewed.group(2)
    else:
        sha = target
        if not SHA_RE.match(sha):
            refuse(65, "commit must be a full lowercase 40-hex sha")
    global ACTIVE_SHA, ACTIVE_INSTANCE
    ACTIVE_SHA = sha
    ACTIVE_INSTANCE = target
    if command == "diff":
        # Read-only: never touches last-result.json, state or the history.
        try:
            cmd_diff(sha)
        except Failure as exc:
            print(json.dumps({"ok": False, "action": "self.diff", "sha": sha, "phase": exc.phase,
                              "error": exc.message, "code": exc.code}, sort_keys=True), file=sys.stderr)
            sys.exit(exc.code)
        except Exception as exc:  # pragma: no cover - unexpected internal error
            print(json.dumps({"ok": False, "action": "self.diff", "sha": sha, "error": "internal error: %s" % exc,
                              "code": 69}, sort_keys=True), file=sys.stderr)
            sys.exit(69)
        return
    started = utcnow()
    try:
        if command == "deploy":
            cmd_deploy(sha, reviewed_sha256)
        else:
            cmd_activate(sha)
    except Failure as exc:
        result = base_result(sha, started, exc.phase, False, code=exc.code, error=exc.message)
        if os.path.isdir(STATE_DIR):
            try:
                finish(result, exc.code)
            except SystemExit:
                raise
        print(json.dumps({"ok": False, "action": "self.update", "sha": sha, "phase": exc.phase,
                          "error": exc.message, "code": exc.code}, sort_keys=True), file=sys.stderr)
        sys.exit(exc.code)
    except SystemExit:
        raise
    except Exception as exc:  # pragma: no cover - unexpected internal error
        result = base_result(sha, started, "internal", False, code=69, error="internal error: %s" % exc)
        if os.path.isdir(STATE_DIR):
            try:
                finish(result, 69)
            except SystemExit:
                raise
        print(json.dumps({"ok": False, "action": "self.update", "sha": sha, "error": "internal error", "code": 69}), file=sys.stderr)
        sys.exit(69)


