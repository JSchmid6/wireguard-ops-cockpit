#!/bin/bash
# =============================================================================
# cockpit-borg-action — der eine sudo-exponierte Einstieg für den Borg-Betrieb.
# -----------------------------------------------------------------------------
# Aufruf (gepinnte Grammatik, alles andere endet mit 64):
#   cockpit-borg-action status     lesend: Zustand des Backups, beider Seiten
#   cockpit-borg-action check      startet einen Repo-Check (lesend, mit --force)
#   cockpit-borg-action repair     startet check --repair --force
#
# Jedes Verb läuft in einer EIGENEN transienten systemd-Unit, nie im Executor
# selbst: der Executor-Dienst ist sandboxed (RestrictAddressFamilies=AF_UNIX,
# ProtectHome=read-only, PrivateTmp=yes) und hängt in seinem eigenen cgroup. Ein
# dort gestarteter borgmatic-Lauf käme nicht per SSH auf die Kiste, könnte
# /root/.cache/borg nicht schreiben, und ein Neustart des Executors (z. B. beim
# Selbst-Update) risse ihn mitten im stundenlangen Check ab.
#   * status:  systemd-run --wait --pipe --collect in eine kurzlebige Unit. Ihre
#     Ausgabe kommt durch `--pipe` hier an, ihr Rückgabecode durch `--wait`.
#   * check/repair: systemd-run OHNE --wait in eine benannte Unit
#     `cockpit-borg-<verb>-<stamp>`, die sofort weiterläuft. Der Laufzustand ist
#     damit systemd-Zustand — `systemctl is-active <unit>` und ihr Journal
#     (`journalctl -u <unit>`) — keine PID-Datei und kein cgroup-Erbe.
#   * Darum ist auch `status` eine Unit: die Abfragen gehen über SSH zum Repo und
#     per curl zur Kiste, beides gibt es in der Executor-Sandbox nicht.
#
# Grenzen (bewusst):
#   * Der Repo-Schlüssel und /etc/borgmatic/config.yaml werden NIE gelesen und
#     nie ausgegeben — die Datei hält Klartext-Zugangsdaten (mysqldump, borg).
#     Es laufen ausschliesslich borgmatic-Kommandos, die den Schlüssel selbst
#     benutzen (als root) und nur ihre Zusammenfassung ausgeben.
#   * Keine freien Argumente: die drei Verben sind die ganze Fläche. Die
#     internen Payload-Verben (`--payload <verb>`) laufen nur aus der eigenen
#     Unit: sie verlangen COCKPIT_BORG_ACTION_IN_UNIT, das die Unit selbst setzt.
#     sudo(8) setzt die Umgebung zurück (env_reset) und darf ohne SETENV nichts
#     mitgeben — der typisierte Weg kann diese Verben also nicht aufrufen.
#   * check/repair starten nur, wenn der nächste borgmatic.timer-Lauf mehr als
#     BORG_ACTION_MIN_HEADROOM (8 h) entfernt ist. Die Zeit kommt aus
#     `systemctl show … NextElapseUSecRealtime` und wird in Epochensekunden
#     gerechnet (zeitzonen- und sommerzeitfest). Ein Check über ~3,5 TB läuft
#     Stunden; ein Start kurz vor dem Timer liesse das nächtliche Backup in die
#     Repo-Sperre laufen (genau das passierte am 22.09.2026).
#   * Kein zweiter Lauf gleichzeitig: eine aktive borg-Wartungs-Unit, ein
#     laufendes borgmatic.service und die Sperrdatei werden vorher geprüft; der
#     Lauf hält die Sperre selbst, solange er dauert.
#   * `check` läuft mit --force: borgmatic überspringt Checks, die innerhalb der
#     konfigurierten Frequenz liegen ("Skipping archives check due to configured
#     frequency") — ohne --force wäre der Lauf ein No-op, der wie ein grüner
#     Check aussieht.
#   * `status` fragt das Repo NICHT ab, während Backup oder Wartung läuft: dann
#     hält borg die Sperre, `list`/`info` scheiterten und das Repo sähe "nicht
#     erreichbar" aus. Stattdessen: `repo: belegt (…)`, rc=0.
#
# Rückgabewerte: 0 ok · 2 Repo nicht erreichbar (nur status) · 3 schon in Arbeit
# oder zu wenig Frist bis zum Timer · 64 Aufruffehler · 67 falscher Host /
# fehlende Umgebung · 69 die Unit konnte nicht starten.
#
# Prüf-Haken (COCKPIT_BORG_ACTION_*: LOCK, STATE_DIR, CONFIG, KISTE_URL,
# KISTE_REPO, MAX_LOG_LINES, UNIT_PREFIX, TIMER, SERVICE, MIN_HEADROOM_SEC,
# STATUS_TIMEOUT_SEC, RUN_TIMEOUT_SEC, IN_UNIT) leiten Pfade und Grenzen für die
# Offline-Prüfung um (test/cockpit-borg-action.test.sh). sudo(8) setzt die
# Umgebung zurück und der Broker gibt nur PATH mit, auf dem typisierten Weg
# sieht der Helfer also immer die echten Pfade und Grenzen.
# =============================================================================
set -uo pipefail
umask 027

readonly BORG_ACTION_LOCK="${COCKPIT_BORG_ACTION_LOCK:-/run/lock/cockpit-borg.lock}"
readonly BORG_ACTION_KISTE_URL="${COCKPIT_BORG_ACTION_KISTE_URL:-http://10.0.0.5:8088/status.txt}"
readonly BORG_ACTION_KISTE_REPO="${COCKPIT_BORG_ACTION_KISTE_REPO:-/media/RAID/backup_VServer/borg}"
readonly BORG_ACTION_STATE_DIR="${COCKPIT_BORG_ACTION_STATE_DIR:-/var/lib/wireguard-ops-cockpit/borg}"
readonly BORG_ACTION_CONFIG="${COCKPIT_BORG_ACTION_CONFIG:-/etc/borgmatic/config.yaml}"
readonly BORG_ACTION_MAX_LOG_LINES="${COCKPIT_BORG_ACTION_MAX_LOG_LINES:-25}"
readonly BORG_ACTION_UNIT_PREFIX="${COCKPIT_BORG_ACTION_UNIT_PREFIX:-cockpit-borg}"
readonly BORG_ACTION_TIMER="${COCKPIT_BORG_ACTION_TIMER:-borgmatic.timer}"
readonly BORG_ACTION_SERVICE="${COCKPIT_BORG_ACTION_SERVICE:-borgmatic.service}"
readonly BORG_ACTION_MIN_HEADROOM="${COCKPIT_BORG_ACTION_MIN_HEADROOM_SEC:-28800}"      # 8 h
readonly BORG_ACTION_STATUS_TIMEOUT="${COCKPIT_BORG_ACTION_STATUS_TIMEOUT_SEC:-200}"    # s
readonly BORG_ACTION_RUN_TIMEOUT="${COCKPIT_BORG_ACTION_RUN_TIMEOUT_SEC:-86400}"        # 24 h

# Die Unit startet diesen Helfer erneut (`--payload <verb>`). Der Pfad muss dafür
# absolut sein — systemd startet die Unit mit Arbeitsverzeichnis /.
BORG_ACTION_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
readonly BORG_ACTION_SELF

usage() {
  cat <<'EOF'
cockpit-borg-action — Borg-Betrieb auf diesem Host.

  status   Backup-Zustand lesen: borgmatic-Timer und letzte Läufe, laufende
           Wartungs-Unit, jüngste Archive, Repo-Kennzahlen und der Zustand der
           Kiste (Statusdatei). Läuft in einer eigenen transienten Unit.
  check    Einen Repo-Check starten (borgmatic check --force, lesend). Läuft als
           benannte Unit `cockpit-borg-check-<stamp>` weiter; Fortschritt mit
           `status` oder `journalctl -u <unit>`. Startet nicht, wenn der nächste
           borgmatic.timer-Lauf in weniger als 8 h ansteht.
  repair   Einen Check mit --repair --force starten (kann beschädigte Archive
           entfernen) — sinnvoll ERST nach einem Check mit Befund; verlangt die
           Freigabe des Operators in der Plan-Policy der Cockpit-API. Gleiche
           Frist- und Sperrprüfung wie check.

Alles andere wird abgelehnt. Der Repo-Schlüssel bleibt auf diesem Host.
EOF
}

die() { printf '%s\n' "$1" >&2; exit "${2:-64}"; }
section() { printf '\n== %s ==\n' "$1"; }

have() { command -v "$1" >/dev/null 2>&1; }

now_iso() { # Zeitstempel; GNU date (Ubuntu) bevorzugt, schlanke Prüf-Images fallen zurück
  date --iso-8601=seconds 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ
}

# borgmatic nur, wenn Konfiguration UND Programm da sind — die Kiste hat keins.
borgmatic_here() { have borgmatic && [ -r "$BORG_ACTION_CONFIG" ]; }

# ---------------------------------------------------------------------------
# Unit-Sicht (Laufzustand ist systemd-Zustand, nicht eine PID-Datei)
# ---------------------------------------------------------------------------
unit_kind() { # cockpit-borg-check-<stamp> -> check
  local unit="${1##*/}"
  unit="${unit%.service}"
  case "$unit" in
    "$BORG_ACTION_UNIT_PREFIX"-check-*)  printf 'check' ;;
    "$BORG_ACTION_UNIT_PREFIX"-repair-*) printf 'repair' ;;
    "$BORG_ACTION_UNIT_PREFIX"-status-*) printf 'status' ;;
    *) printf '?' ;;
  esac
}

recorded_unit() { # zuletzt gestartete Wartungs-Unit (aus dem Zustandsverzeichnis)
  local unit
  unit="$(cat "$BORG_ACTION_STATE_DIR/last.unit" 2>/dev/null || true)"
  case "$unit" in
    "$BORG_ACTION_UNIT_PREFIX"-check-*|"$BORG_ACTION_UNIT_PREFIX"-repair-*) printf '%s' "$unit" ;;
  esac
}

recorded_kind() {
  local kind
  kind="$(cat "$BORG_ACTION_STATE_DIR/last.kind" 2>/dev/null || true)"
  case "$kind" in
    check|repair) printf '%s' "$kind" ;;
    *) printf '?' ;;
  esac
}

maintenance_unit_candidates() { # jede Unit, die eine Wartung sein könnte
  local recorded
  recorded="$(recorded_unit)"
  [ -n "$recorded" ] && printf '%s\n' "$recorded"
  have systemctl || return 0
  systemctl list-units --all --no-legend --plain --no-pager \
    "$BORG_ACTION_UNIT_PREFIX-check-*.service" "$BORG_ACTION_UNIT_PREFIX-repair-*.service" 2>/dev/null \
    | awk 'NF { print $1 }' || true
}

active_maintenance_unit() { # erste aktive Wartungs-Unit auf stdout, rc=1 wenn keine
  local unit
  have systemctl || return 1
  while read -r unit; do
    [ -n "$unit" ] || continue
    if systemctl is-active --quiet "$unit" 2>/dev/null; then
      printf '%s' "${unit%.service}"
      return 0
    fi
  done < <(maintenance_unit_candidates)
  return 1
}

journal_tail() { # journal_tail <unit>
  if ! have journalctl; then
    printf '%s\n' "journalctl fehlt — Journal dieser Unit nicht lesbar."
    return 0
  fi
  local out
  out="$(journalctl -u "$1" --no-pager -o short-iso -n "$BORG_ACTION_MAX_LOG_LINES" 2>&1 || true)"
  if [ -n "$out" ]; then printf '%s\n' "$out"; else printf 'keine Journalzeilen zu %s.\n' "$1"; fi
}

# ---------------------------------------------------------------------------
# Sperre, laufendes Backup
# ---------------------------------------------------------------------------
lock_held() { # hält irgendwer die Sperrdatei?
  [ -e "$BORG_ACTION_LOCK" ] || return 1
  have flock || return 1
  if flock -n "$BORG_ACTION_LOCK" true 2>/dev/null; then return 1; fi
  return 0
}

borgmatic_busy() {
  have systemctl || return 1
  systemctl is-active --quiet "$BORG_ACTION_SERVICE" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Frist bis zum nächsten Timer-Lauf (zeitzonenfest in Epochensekunden)
# ---------------------------------------------------------------------------
parse_next_elapse() { # parse_next_elapse <systemctl-Wert> -> Epoche auf stdout
  local raw="$1" number stamp
  raw="${raw##*=}"                                   # "Property=Wert" -> "Wert"
  raw="${raw#"${raw%%[![:space:]]*}"}"               # führende Leerzeichen weg
  raw="${raw%"${raw##*[![:space:]]}"}"               # Schlussleerzeichen weg
  [ -n "$raw" ] || return 1
  case "$raw" in
    n/a|N/A|none|unknown|0) return 1 ;;
  esac
  number="${raw%% *}"                                # erstes Feld
  if [[ "$number" =~ ^[0-9]+$ ]]; then
    # systemctl --timestamp=us+utc liefert "<us> @ <Wanduhr UTC>"; `unix` liefert
    # Sekunden, `us` Mikrosekunden. Beides ohne Zeitzone — reine Zahl ist gut.
    if [ "${#number}" -ge 14 ]; then printf '%s\n' "$(( number / 1000000 ))"; return 0; fi
    if [ "${#number}" -ge 9 ]; then printf '%s\n' "$number"; return 0; fi
    return 1
  fi
  # Wanduhr, wie systemctl sie ausgibt: "Tue 2026-09-29 01:53:08 CEST". Wochentag
  # und Zonenkürzel fallen weg, die Wanduhr wird in der LOKALEN Zone ausgewertet —
  # genau die Zone, mit der systemctl formatiert hat. Gerechnet wird die Differenz
  # in Epochensekunden, damit Zeitzone und Sommerzeit keine Rolle spielen.
  stamp="$(printf '%s' "$raw" | sed -E 's/^[A-Za-z]{3}[[:space:]]+//; s/[[:space:]]+[A-Za-z]{2,6}$//')"
  case "$stamp" in
    *[0-9][0-9][0-9][0-9]*) ;;                         # nur mit Jahreszahl rechnen
    *) return 1 ;;
  esac
  if date -u -d "$stamp" +%s 2>/dev/null; then return 0; fi
  if date -u -d "$raw" +%s 2>/dev/null; then return 0; fi
  return 1
}

guard_timer_headroom() {
  local raw next now delta
  have systemctl || die "systemctl fehlt — der nächste $BORG_ACTION_TIMER-Lauf ist nicht prüfbar." 67
  if ! systemctl is-active --quiet "$BORG_ACTION_TIMER" 2>/dev/null; then
    printf 'Frist: %s ist nicht aktiv — kein anstehender Backup-Lauf, der kollidieren könnte.\n' "$BORG_ACTION_TIMER"
    return 0
  fi
  raw="$(systemctl show --property=NextElapseUSecRealtime --value "$BORG_ACTION_TIMER" 2>/dev/null || true)"
  if ! next="$(parse_next_elapse "$raw")" || [ -z "$next" ]; then
    die "der nächste $BORG_ACTION_TIMER-Lauf ist nicht ermittelbar (NextElapseUSecRealtime='${raw}') — ohne Fristprüfung startet hier kein stundenlanger Lauf." 3
  fi
  now="$(date -u +%s)"
  delta=$(( next - now ))
  if [ "$delta" -lt "$BORG_ACTION_MIN_HEADROOM" ]; then
    die "zu wenig Abstand: der nächste $BORG_ACTION_TIMER-Lauf steht in $(( delta / 3600 )) h $(( (delta % 3600) / 60 )) min an (Grenze $(( BORG_ACTION_MIN_HEADROOM / 3600 )) h). Ein Check über Stunden liefe in die Repo-Sperre des nächtlichen Backups — später erneut bestellen." 3
  fi
  printf 'Frist: nächster %s-Lauf in %s h %s min (Grenze %s h) — in Ordnung.\n' \
    "$BORG_ACTION_TIMER" "$(( delta / 3600 ))" "$(( (delta % 3600) / 60 ))" "$(( BORG_ACTION_MIN_HEADROOM / 3600 ))"
  return 0
}

guard_no_run() {
  local unit
  have flock || die "flock fehlt auf diesem Host — ohne die Sperre gäbe es keinen Schutz gegen einen zweiten Lauf auf demselben Repo." 67
  if unit="$(active_maintenance_unit)"; then
    die "es läuft bereits eine Wartung: Unit $unit ($(unit_kind "$unit")). Fortschritt mit 'status' oder 'journalctl -u $unit' ansehen." 3
  fi
  if borgmatic_busy; then
    die "$BORG_ACTION_SERVICE ist gerade aktiv (nächtliches Backup). Kein zweiter Lauf auf demselben Repo." 3
  fi
  if lock_held; then
    die "$BORG_ACTION_LOCK ist belegt — ein anderer Lauf hält das Repo (nicht als borg-Unit, z. B. von Hand gestartet)." 3
  fi
  return 0
}

# ---------------------------------------------------------------------------
# status (Payload — läuft IN der eigenen Unit)
# ---------------------------------------------------------------------------
show_kiste_status() { # Zustand der Kiste ohne SSH: die Statusdatei des Dateidienstes
  section "Kiste (Statusdatei $BORG_ACTION_KISTE_URL)"
  if ! have curl; then
    printf '%s\n' "curl fehlt auf diesem Host — Kiste nicht abgefragt."
    return 0
  fi
  local body
  if ! body="$(curl -fsS --max-time 10 "$BORG_ACTION_KISTE_URL" 2>&1)"; then
    printf 'Statusdatei nicht erreichbar: %s\n' "$body"
    return 0
  fi
  printf '%s\n' "$body" | grep -E '^(DATE|UPTIME|LOAD|FAILED:|FAILED-UNIT|MDSTAT|md1|DF)' | head -n 20
  printf '%s\n' "$body" | grep -qE '\[4/4\] *\[UUUU\]' && printf '%s\n' "-> Array vollständig (4/4, [UUUU])."
  return 0
}

show_kiste_local() { # auf der Kiste selbst: Mount, Platz und das Repo-Verzeichnis
  section "Kiste: /media/RAID"
  df -h /media/RAID 2>/dev/null || printf '%s\n' "/media/RAID nicht eingehängt."
  section "Kiste: Repo-Verzeichnis $BORG_ACTION_KISTE_REPO"
  if [ -d "$BORG_ACTION_KISTE_REPO" ]; then
    printf 'vorhanden: ja\n'
    printf 'letzte Änderung: %s\n' "$(date -r "$BORG_ACTION_KISTE_REPO" --iso-8601=seconds 2>/dev/null || stat -c %y "$BORG_ACTION_KISTE_REPO")"
    printf 'Grösse (du -sh): %s\n' "$(du -sh "$BORG_ACTION_KISTE_REPO" 2>/dev/null | cut -f1)"
    printf 'Segmente: %s\n' "$(find "$BORG_ACTION_KISTE_REPO/data" -type f 2>/dev/null | wc -l)"
    printf 'jüngstes Datensegment: %s\n' "$(find "$BORG_ACTION_KISTE_REPO/data" -type f -printf '%TY-%Tm-%TdT%TH:%TM:%TS %p\n' 2>/dev/null | sort | tail -n 1)"
  else
    printf '%s\n' "vorhanden: nein ($BORG_ACTION_KISTE_REPO fehlt)"
  fi
  return 0
}

status_borgmatic() {
  section "VPS: borgmatic"
  if have systemctl; then
    printf 'Timer: %s\n' "$(systemctl is-active "$BORG_ACTION_TIMER" 2>/dev/null || true)"
    printf 'Dienst jetzt: %s\n' "$(systemctl is-active "$BORG_ACTION_SERVICE" 2>/dev/null || true)"
    systemctl list-timers "$BORG_ACTION_TIMER" --no-pager 2>/dev/null | head -n 2
  else
    printf '%s\n' "systemctl fehlt — Timerzustand unbekannt."
  fi

  section "VPS: laufende Wartung (Unit)"
  local unit
  if unit="$(active_maintenance_unit)"; then
    printf 'läuft: ja (Unit %s, Art %s)\n' "$unit" "$(unit_kind "$unit")"
    printf 'Journal: journalctl -u %s\n' "$unit"
    journal_tail "$unit"
  elif lock_held; then
    printf 'läuft: ja (Sperrdatei %s belegt, keine borg-Wartungs-Unit aktiv)\n' "$BORG_ACTION_LOCK"
    printf '%s\n' "Das ist ein Lauf ausserhalb dieses Wegs (von Hand gestartet) oder eine Unit, die systemd nicht mehr kennt."
  else
    printf '%s\n' "läuft: nein"
    local last
    last="$(recorded_unit)"
    if [ -n "$last" ]; then
      printf 'letzte Wartung: %s (Art %s)\n' "$last" "$(recorded_kind)"
      printf 'Journal: journalctl -u %s\n' "$last"
      journal_tail "$last"
    fi
  fi

  section "VPS: letzte Läufe des Backups (Journal)"
  if have journalctl; then
    journalctl -u "$BORG_ACTION_SERVICE" --since '-14 days' --no-pager -o short-iso 2>/dev/null \
      | grep -aE 'Starting borgmatic|Finished borgmatic|borgmatic.service: (Succeeded|Failed|Deactivated)|CRITICAL|ERROR|Error|Failed' \
      | tail -n 20 || true
    journalctl -u "$BORG_ACTION_SERVICE" --since '-14 days' --no-pager -o short-iso 2>/dev/null | grep -qa . \
      || printf '%s\n' "keine Journalzeilen lesbar (Rechte?)"
  else
    printf '%s\n' "journalctl fehlt — Laufhistorie unbekannt."
  fi

  # B4: Ein laufendes Backup oder eine Wartung hält die Repo-Sperre. `list` und
  # `info` scheiterten dann und das Repo sähe "nicht erreichbar" aus (rc=2),
  # obwohl es nur belegt ist. Deshalb hier NICHT abfragen, sondern melden.
  local busy=""
  if unit="$(active_maintenance_unit)"; then busy="$(unit_kind "$unit")"; fi
  if [ -z "$busy" ] && borgmatic_busy; then busy="Backup"; fi
  if [ -n "$busy" ]; then
    section "VPS: Repo — nicht abgefragt"
    printf 'repo: belegt (%s läuft)\n' "$busy"
    printf '%s\n' "borg hält gerade die Repo-Sperre; list/info würden sie nur sehen und das Repo fälschlich als nicht erreichbar melden. Nach dem Lauf erneut fragen."
    REPO_REACHABLE="belegt (nicht abgefragt)"
  else
    section "VPS: Archive (borgmatic list --last 5)"
    local archives
    archives="$(borgmatic --verbosity 0 list --last 5 2>&1)"
    if [ $? -eq 0 ]; then REPO_REACHABLE="ja"; else REPO_REACHABLE="nein"; fi
    printf '%s\n' "$archives" | tail -n 12

    section "VPS: Repo-Kennzahlen (borgmatic info --last 1)"
    borgmatic --verbosity 0 info --last 1 2>&1 \
      | grep -aE 'Archive name|Time \(start\)|Time \(end\)|Duration|Number of files|Original size|This archive:|All archives:|Deduplicated size' \
      | tail -n 12
  fi
  # Ein nicht erreichbares Repo ist der Befund, nicht eine Randnotiz: rc=2.
  # "belegt" ist kein Befund — die Repo-Abfrage steht nur noch aus.
  [ "$REPO_REACHABLE" = "nein" ] || return 0
  return 2
}

run_status() {
  printf 'cockpit-borg-action status — %s\n' "$(now_iso)"
  printf 'Host: %s\n' "$(hostname -f 2>/dev/null || hostname)"
  local rc=0 unit running="nein"
  REPO_REACHABLE="n/a (Kiste)"
  if borgmatic_here; then
    printf '%s\n' "Rolle: VPS (borgmatic vorhanden, Repo-Schlüssel bleibt hier)"
    status_borgmatic || rc=$?
    show_kiste_status
  else
    printf '%s\n' "Rolle: Kiste (kein borgmatic — Sicht auf das empfangende Repo)"
    show_kiste_local
    show_kiste_status
  fi
  if unit="$(active_maintenance_unit)"; then running="ja"; else unit="-"; fi
  section "ZUSAMMENFASSUNG"
  printf 'repo_erreichbar: %s\n' "$REPO_REACHABLE"
  printf 'borgmatic_busy: %s\n' "$(borgmatic_busy && printf ja || printf nein)"
  printf 'wartung_laeuft: %s\n' "$running"
  printf 'wartung_unit: %s\n' "$unit"
  return "$rc"
}

# ---------------------------------------------------------------------------
# check / repair (Payload — läuft IN der eigenen Unit)
# ---------------------------------------------------------------------------
run_maintenance() { # verb (check|repair)
  local verb="$1"
  borgmatic_here || die "borgmatic (und $BORG_ACTION_CONFIG) fehlen auf diesem Host — check/repair laufen auf dem VPS." 67

  local args=(--verbosity 1 check)
  [ "$verb" = "repair" ] && args+=(--repair)
  args+=(--force)

  # Die Sperre hält dieser Lauf selbst: der Deskriptor bleibt offen, solange
  # borgmatic läuft, und systemd räumt ihn mit der Unit ab. Zweiter Riegel neben
  # der Unit-Prüfung des Aufrufers.
  if have flock; then
    exec 8>>"$BORG_ACTION_LOCK" || die "Sperrdatei $BORG_ACTION_LOCK ist nicht öffenbar." 67
    flock -n 8 || die "$BORG_ACTION_LOCK ist belegt — ein anderer Lauf hält das Repo." 3
  fi

  printf 'Unit %s: borgmatic %s\n' "${COCKPIT_BORG_ACTION_IN_UNIT:-?}" "${args[*]}"
  printf 'Start: %s\n' "$(now_iso)"
  local rc=0
  if [ "$verb" = "repair" ]; then
    # borg fragt sonst interaktiv "Type 'YES'…" und der Lauf stirbt headless.
    BORG_CHECK_I_KNOW_WHAT_I_AM_DOING=YES borgmatic "${args[@]}" || rc=$?
  else
    borgmatic "${args[@]}" || rc=$?
  fi
  printf 'Ende: %s (rc=%s)\n' "$(now_iso)" "$rc"
  return "$rc"
}

# ---------------------------------------------------------------------------
# Aufrufer-Seite: Unit starten (das Verb selbst läuft nicht hier)
# ---------------------------------------------------------------------------
require_root() {
  [ "$(id -u)" -eq 0 ] || die "cockpit-borg-action läuft als root über den typisierten Executor." 77
}

payload_context_ok() {
  local unit="${COCKPIT_BORG_ACTION_IN_UNIT:-}"
  [ -n "$unit" ] || return 1
  case "$unit" in
    "$BORG_ACTION_UNIT_PREFIX"-*) return 0 ;;
  esac
  return 1
}

status_via_unit() {
  have systemd-run || die "systemd-run fehlt auf diesem Host — status läuft in seiner eigenen Unit." 67
  local stamp unit rc=0
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  unit="$BORG_ACTION_UNIT_PREFIX-status-$stamp-$$"
  systemd-run --wait --pipe --collect --quiet --unit="$unit" \
    --description="Cockpit borg status" \
    --property=Type=exec --property=RuntimeMaxSec="$BORG_ACTION_STATUS_TIMEOUT" \
    --setenv="COCKPIT_BORG_ACTION_IN_UNIT=$unit" \
    -- "$BORG_ACTION_SELF" --payload status || rc=$?
  case "$rc" in
    0) exit 0 ;;
    2|3|64|65|66|67|68|69|77) exit "$rc" ;;
    *) die "die status-Unit $unit endete mit rc=$rc — Journal: journalctl -u $unit" 69 ;;
  esac
}

start_maintenance() { # verb (check|repair)
  local verb="$1"
  borgmatic_here || die "borgmatic (und $BORG_ACTION_CONFIG) fehlen auf diesem Host — check/repair laufen auf dem VPS." 67
  have systemd-run || die "systemd-run fehlt auf diesem Host — check/repair laufen in ihrer eigenen Unit." 67
  guard_no_run
  guard_timer_headroom

  install -d -m 0750 -o root -g root "$BORG_ACTION_STATE_DIR" \
    || die "Zustandsverzeichnis $BORG_ACTION_STATE_DIR ist nicht anlegbar." 67

  local stamp unit rc=0 shown
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  unit="$BORG_ACTION_UNIT_PREFIX-$verb-$stamp"
  shown="--verbosity 1 check --force"
  [ "$verb" = "repair" ] && shown="--verbosity 1 check --repair --force"

  # Ohne --wait: die Unit läuft weiter, wenn dieser Aufruf (und der Executor
  # dahinter) längst fertig ist. Type=exec sorgt dafür, dass ein Startfehler
  # hier noch auffällt statt in der Unit zu verpuffen.
  systemd-run --quiet --collect --unit="$unit" \
    --description="Cockpit borg $verb" \
    --property=Type=exec --property=RuntimeMaxSec="$BORG_ACTION_RUN_TIMEOUT" \
    --setenv="COCKPIT_BORG_ACTION_IN_UNIT=$unit" \
    -- "$BORG_ACTION_SELF" --payload "$verb" || rc=$?
  [ "$rc" -eq 0 ] || die "die Unit $unit konnte nicht starten (systemd-run rc=$rc) — es läuft nichts, es wurde nichts verändert." 69

  printf '%s\n' "$unit" > "$BORG_ACTION_STATE_DIR/last.unit"
  printf '%s\n' "$verb" > "$BORG_ACTION_STATE_DIR/last.kind"

  printf 'gestartet: borgmatic %s\n' "$shown"
  printf 'Unit: %s\n' "$unit"
  printf 'Journal: journalctl -u %s (folgen: -f)\n' "$unit"
  printf '%s\n' "Fortschritt: 'cockpit-borg-action status' oder 'systemctl status $unit'."
  printf '%s\n' "Der Lauf überlebt diese Sitzung und den Executor; ein zweiter Lauf wird von Frist- und Sperrprüfung abgewiesen."
  if [ "$verb" = "repair" ]; then
    printf '%s\n' "repair läuft mit --repair --force: borg kann beschädigte Archive entfernen. Der Check davor sollte den Befund zeigen (doc/setup/borg-maintenance.md)."
  fi
  exit 0
}

# ---------------------------------------------------------------------------
# Grammatik
# ---------------------------------------------------------------------------
if [ "$#" -lt 1 ]; then
  usage >&2
  exit 64
fi

case "$1" in
  status)
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    require_root
    status_via_unit
    ;;
  check|repair)
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    require_root
    start_maintenance "$1"
    ;;
  --payload)
    shift
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    require_root
    payload_context_ok || die "die Payload-Verben laufen nur aus der eigenen Unit (COCKPIT_BORG_ACTION_IN_UNIT fehlt oder passt nicht)." 64
    case "$1" in
      status) run_status ;;
      check|repair) run_maintenance "$1" ;;
      *) die "unbekanntes Payload-Verb: $1" 64 ;;
    esac
    ;;
  -h|--help|help)
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    usage
    exit 0
    ;;
  *)
    usage >&2
    die "unbekanntes Verb: $1" 64
    ;;
esac
